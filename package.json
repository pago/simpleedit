{
  "name": "simpleedit",
  "version": "0.15.0",
  "description": "An opinionated Agentic Development Environment",
  "author": "Patrick Gotthardt <patrick@pagosoft.com>",
  "email": "patrick@pagosoft.com",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm build:mcp-server && electron-vite dev",
    "build": "electron-vite build && pnpm build:mcp-server",
    "build:mcp-server": "node scripts/build-mcp-server.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "package": "electron-vite build && pnpm build:mcp-server && electron-builder --config electron-builder.yml",
    "package:mac": "electron-vite build && pnpm build:mcp-server && electron-builder --mac --config electron-builder.yml",
    "package:win": "electron-vite build && pnpm build:mcp-server && electron-builder --win --config electron-builder.yml",
    "package:linux": "electron-vite build && pnpm build:mcp-server && electron-builder --linux --config electron-builder.yml",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:integration": "pnpm build:mcp-server && RUN_MCP_INTEGRATION=1 vitest run --project unit src/main/__tests__/mcp-bridge.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:build": "electron-vite build && playwright test",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@json-render/svelte": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xyflow/svelte": "^1.5.2",
    "elkjs": "^0.11.1",
    "mermaid": "^11.14.0",
    "node-pty": "^1.0.0",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.58.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@vitest/browser": "^4.1.1",
    "@vitest/browser-playwright": "^4.1.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^4.0.3",
    "electron": "^35.1.2",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "monaco-editor": "^0.52.2",
    "playwright": "^1.58.2",
    "simple-git": "^3.27.0",
    "svelte": "^5.28.2",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.1",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.17.5"
  }
}
