#!/usr/bin/env bash
# Fake Codex TUI for Electron E2E. It stays alive like the real native TUI and
# supports deterministic crash/session lifecycle scenarios through env flags.
if [ -n "${SIMPLEEDIT_FAKE_CODEX_EXIT:-}" ]; then
  echo "fake codex: simulated spawn failure"
  exit "${SIMPLEEDIT_FAKE_CODEX_EXIT}"
fi
echo "fake codex ready"
while true; do
  if IFS= read -r -t 3600 line; then
    case "$line" in
      *"/exit"*) exit 0 ;;
      *"/hooks"*) echo "fake codex: hooks trusted" ;;
    esac
  else
    # A PTY session must stay EOF-proof (see e2e/bin/claude), but when driven
    # over pipes (`codex app-server` model discovery) EOF means the app closed
    # our stdin — exit like the real app-server does, so a fake discovery child
    # can never outlive the app that spawned it.
    if [ ! -t 0 ]; then exit 0; fi
    sleep 1
  fi
done
