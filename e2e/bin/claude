#!/usr/bin/env bash
# Fake `claude` binary for e2e tests. The real CLI isn't installed in CI, so
# the PTY would otherwise exit immediately with "command not found", triggering
# auto-close-on-pty:exit and removing the session before Playwright can observe
# it.
#
# This script emits a startup line (some tests wait on pty:data to detect the
# terminal id), then idles until told to exit or killed. Of its arguments it
# reads only `--session-id` — the tests don't exercise Claude's protocol, they
# exercise SimpleEdit's session UI.
#
# IMPORTANT — must use bash, not /bin/sh: this relies on `read -t`, which dash
# (Ubuntu's /bin/sh, used by CI) does NOT support. Under dash the read errored
# every iteration, the loop fell through, and the script `exit 0`d immediately
# — which the session store treats as a graceful exit and auto-closes the
# session, so every "spawn a session then observe it" test failed in CI only.
# Idling is also EOF-proof: a read failure (EOF, timeout, or unsupported flag)
# never exits the process — only an explicit "/exit" or a SIGHUP from node-pty
# on app shutdown ends it. A clean exit must mean "/exit", nothing else.
#
# Extras driven by tests:
#  - SIMPLEEDIT_FAKE_CLAUDE_OSC=1: emit one OSC title with the real CLI's idle
#    marker (✳ Claude Code) so the OSC→claude:status pipeline can be asserted
#    deterministically (the real CLI's title behaviour depends on folder trust
#    state, which a fresh temp repo never has).
#  - Reading "/exit" on stdin exits 0, mirroring the real CLI's slash command.
#  - Reading an `initialize` control request answers with a one-model catalog,
#    so the app's model discovery resolves instead of waiting out its timeout.
#  - `--session-id <id>` with CLAUDE_CONFIG_DIR set: write a stub transcript
#    where the real CLI would, so Resume and Fork pass SimpleEdit's
#    transcript check. Never written without CLAUDE_CONFIG_DIR, which would
#    mean the developer's real ~/.claude.
#  - SIMPLEEDIT_FAKE_CLAUDE_ENV_DUMP=<file>: write the environment a session
#    launch (one with `--session-id`) got to <file>. Model discovery passes no
#    session id, so it never overwrites the dump.
#  - SIMPLEEDIT_FAKE_CLAUDE_EXIT=<code>: print a message and exit immediately
#    with that code, simulating a spawn failure/crash (for the exited-state
#    UI). Used instead of nuking PATH, which would also break Electron's own
#    launch under CI.
#  - SIMPLEEDIT_FAKE_CLAUDE_PRINT_EXIT=1: a `--print` run (a bounded task such
#    as Screen PRs triage) exits at once with no result, instead of idling
#    until the task's timeout.
#  - SIMPLEEDIT_FAKE_CLAUDE_COMPANION=1, for a session SimpleEdit wired to its
#    bridge (`--settings` + `--mcp-config`): act like a review companion via
#    e2e/support/fake-claude-bridge.mjs. The launch turn ends with a `Stop`
#    hook, and every typed `[Review thread rt_… · …]` prompt is confirmed with
#    `UserPromptSubmit`, answered with `reply_to_thread`, and ended with `Stop`.
#    Such a session can also act as an author (request_review): a typed line
#    `fake-request-review <pr-url>` calls `request_review` with a briefing, and
#    a typed `[Review r_… submitted]` hand-back is confirmed, read back with
#    `get_review` (written to SIMPLEEDIT_FAKE_CLAUDE_GET_REVIEW_OUT when set)
#    and ended with `Stop`.
if [ -n "${SIMPLEEDIT_FAKE_CLAUDE_EXIT:-}" ]; then
  echo "fake claude: simulated spawn failure"
  exit "${SIMPLEEDIT_FAKE_CLAUDE_EXIT}"
fi
session_id=""
resume_id=""
settings=""
mcp_config=""
print_mode=""
prev=""
for arg in "$@"; do
  case "$prev" in
    --session-id) session_id="$arg" ;;
    --resume) resume_id="$arg" ;;
    --settings) settings="$arg" ;;
    --mcp-config) mcp_config="$arg" ;;
  esac
  if [ "$arg" = "--print" ]; then print_mode=1; fi
  prev="$arg"
done
if [ -n "$print_mode" ] && [ "${SIMPLEEDIT_FAKE_CLAUDE_PRINT_EXIT:-}" = "1" ]; then
  exit 0
fi
companion=""
if [ "${SIMPLEEDIT_FAKE_CLAUDE_COMPANION:-}" = "1" ] && [ -n "$settings" ] && [ -n "$mcp_config" ] && [ -n "${session_id:-$resume_id}" ]; then
  companion=1
fi
bridge_js="$(cd "$(dirname "$0")/../support" && pwd)/fake-claude-bridge.mjs"
companion_bridge() {
  node "$bridge_js" "$1" "$settings" "$mcp_config" "${session_id:-$resume_id}" "${2:-}" "${3:-}"
}
if [ -n "$session_id" ] && [ -n "${SIMPLEEDIT_FAKE_CLAUDE_ENV_DUMP:-}" ]; then
  env > "${SIMPLEEDIT_FAKE_CLAUDE_ENV_DUMP}"
fi
if [ -n "$session_id" ] && [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
  project_dir="${CLAUDE_CONFIG_DIR}/projects/$(pwd -P | sed 's/[^A-Za-z0-9]/-/g')"
  mkdir -p "$project_dir" && echo '{"type":"fake"}' > "${project_dir}/${session_id}.jsonl"
fi
echo "fake claude ready"
if [ "${SIMPLEEDIT_FAKE_CLAUDE_OSC:-}" = "1" ]; then
  printf '\033]0;\342\234\263 Claude Code\007'
fi
if [ -n "$companion" ]; then companion_bridge stop; fi
while true; do
  if IFS= read -r -t 3600 line; then
    case "$line" in
      *"/exit"*) exit 0 ;;
      *"fake-request-review "*)
        if [ -n "$companion" ]; then
          pr_url="$(printf '%s' "$line" | sed -n 's/.*fake-request-review \([^ ]*\).*/\1/p')"
          companion_bridge request "$pr_url" "$line"
        fi
        ;;
      *"[Review r_"*" submitted]"*)
        if [ -n "$companion" ]; then
          review_id="$(printf '%s' "$line" | sed -n 's/.*\[Review \(r_[A-Za-z0-9-]*\) submitted\].*/\1/p')"
          if [ -n "$review_id" ]; then companion_bridge handback "$review_id" "$line"; fi
        fi
        ;;
      *"[Review thread rt_"*)
        if [ -n "$companion" ]; then
          thread_id="$(printf '%s' "$line" | sed -n 's/.*\[Review thread \(rt_[A-Za-z0-9-]*\).*/\1/p')"
          if [ -n "$thread_id" ]; then companion_bridge answer "$thread_id" "$line"; fi
        fi
        ;;
      *'"subtype":"initialize"'*)
        echo '{"type":"control_response","response":{"subtype":"success","request_id":"models","response":{"models":[{"value":"sonnet","displayName":"Sonnet (fake)"}]}}}'
        ;;
    esac
  else
    # EOF / timeout / unsupported flag — keep idling rather than exiting, so a
    # closed-stdin PTY doesn't masquerade as a graceful session exit.
    sleep 1
  fi
done
