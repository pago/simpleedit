#!/bin/sh
# Fake `claude` binary for e2e tests. The real CLI isn't installed in CI, so
# the PTY would otherwise exit immediately with "command not found", triggering
# auto-close-on-pty:exit and removing the tab before Playwright can observe it.
#
# This script emits a startup line (some tests wait on pty:data to detect the
# terminal id), then blocks long enough for assertions to run. It ignores all
# arguments — the tests don't exercise Claude's protocol, they exercise
# SimpleEdit's tab UI.
#
# `exec sleep 3600` ensures Ctrl-C / SIGTERM from the test teardown propagates
# through to sleep instead of being swallowed by an extra shell frame.
echo "fake claude ready"
exec sleep 3600
