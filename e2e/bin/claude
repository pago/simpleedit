#!/bin/sh
# Fake `claude` binary for e2e tests. The real CLI isn't installed in CI, so
# the PTY would otherwise exit immediately with "command not found", triggering
# auto-close-on-pty:exit and removing the tab before Playwright can observe it.
#
# This script emits a startup line (some tests wait on pty:data to detect the
# terminal id), then idles. It ignores all arguments — the tests don't exercise
# Claude's protocol, they exercise SimpleEdit's session UI.
#
# Extras driven by tests:
#  - SIMPLEEDIT_FAKE_CLAUDE_OSC=1: emit one OSC title with the real CLI's
#    idle marker (✳ Claude Code) so the OSC→claude:status pipeline can be
#    asserted deterministically (the real CLI's title behaviour depends on
#    folder trust state, which a fresh temp repo never has).
#  - Reading "/exit" on stdin exits 0, mirroring the real CLI's slash command,
#    so pty:exit propagation can be tested without the real binary.
#
# The read timeout bounds idle lifetime at ~60s; node-pty SIGHUP on app
# shutdown kills it immediately, so the bound shouldn't normally be hit.
echo "fake claude ready"
if [ "${SIMPLEEDIT_FAKE_CLAUDE_OSC:-}" = "1" ]; then
  printf '\033]0;\342\234\263 Claude Code\007'
fi
while read -t 60 line; do
  case "$line" in
    *"/exit"*) exit 0 ;;
  esac
done
exit 0
